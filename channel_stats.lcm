struct channel_stats {
    string channel;
    string type;
    int32_t num_msgs;
    int64_t latest_msg_timestamp_ns;
    float hz;
    float inv_hz;
    float jitter;
    float bandwidth;
    int32_t undecodable;
}

struct channel_stats_list {
    int32_t num_channels;
    channel_stats channels[num_channels];
}